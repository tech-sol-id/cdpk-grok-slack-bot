# Slack App Credentials
# Dapatkan dari menu "OAuth & Permissions" (dimulai dengan xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Dapatkan dari menu "Basic Information" -> "App-Level Tokens" dengan scope connections:write (dimulai dengan xapp-)
SLACK_APP_TOKEN=xapp-your-app-token

# xAI Credentials
# Dapatkan dari https://console.x.ai (dimulai dengan xai-)
XAI_API_KEY=xai-your-api-key

# Model Grok yang digunakan (pilihan: grok-2, grok-2-mini)
XAI_MODEL=grok-2-mini

# System Prompt identitas bot
SYSTEM_PROMPT=Anda adalah asisten AI resmi CDPK HQ yang didukung oleh Grok. Berikan jawaban yang cerdas, ringkas, solutif, dan profesional.
